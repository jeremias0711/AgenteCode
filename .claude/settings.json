{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(python -m pytest *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(python -m pytest *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo archive *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git pull *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git revert *)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(git branch -D *)",
      "PowerShell(git tag -d *)",
      "PowerShell(git tag --delete *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo archive *)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.gitignore)",
      "Edit(/.gitattributes)",
      "Edit(/Game/Packages/manifest.json)",
      "Edit(/Game/Packages/packages-lock.json)",
      "Edit(/Game/ProjectSettings/ProjectVersion.txt)"
    ],
    "deny": [
      "Edit(/templates/originals/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git reset * --merge*)",
      "Bash(git reset --keep*)",
      "Bash(git reset * --keep*)",
      "Bash(git clean -*f*)",
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push --mirror *)",
      "Bash(git push * --mirror *)",
      "Bash(git push * --mirror)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * --delete)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git reset --merge*)",
      "PowerShell(git reset * --merge*)",
      "PowerShell(git reset --keep*)",
      "PowerShell(git reset * --keep*)",
      "PowerShell(git clean -*f*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push * --force)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push --mirror *)",
      "PowerShell(git push * --mirror *)",
      "PowerShell(git push * --mirror)",
      "PowerShell(git push --delete *)",
      "PowerShell(git push * --delete *)",
      "PowerShell(git push * --delete)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "-c",
              "import hashlib,runpy,sys,os;p=sys.argv[1];d=open(p,'rb').read() if os.path.isfile(p) else b'';(sys.stderr.write('guard.py no coincide con el SHA-256 esperado: bloqueado\\n'),sys.exit(2)) if hashlib.sha256(d).hexdigest()!='db14424c5a5982347dac3519a72ce4a993cc1f08cca13d3c279a1033cb39942f' else runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
