// Phase 17: visual jungle ground of the maps (relief mesh generated by JungleTerrainBuilder).
// One tileable forest-ground texture and one rock texture, blended per vertex: vertex RGB is a tint (0.5 = neutral,
// moss / dirt / clearing / shade), vertex alpha is the rock weight (slopes and hill tops). World-space UVs, so the
// texture density is the same everywhere. Standard lighting with shadows; built-in render pipeline, WebGL friendly
// (shader model 3.0, two texture samples, no extra passes).
Shader "GDA/JungleGround"
{
    Properties
    {
        _MainTex ("Forest ground", 2D) = "white" {}
        _RockTex ("Rock", 2D) = "gray" {}
        _Tiling ("Ground tiling (metres per repeat)", Float) = 4
        _RockTiling ("Rock tiling (metres per repeat)", Float) = 3
        _Glossiness ("Smoothness", Range(0, 1)) = 0.1
    }
    SubShader
    {
        Tags { "RenderType" = "Opaque" "Queue" = "Geometry" }
        LOD 200

        CGPROGRAM
        #pragma surface surf Standard fullforwardshadows vertex:vert
        #pragma target 3.0

        sampler2D _MainTex;
        sampler2D _RockTex;
        float _Tiling;
        float _RockTiling;
        half _Glossiness;

        struct Input
        {
            float3 worldPos;
            float4 vcolor;
        };

        void vert(inout appdata_full v, out Input o)
        {
            UNITY_INITIALIZE_OUTPUT(Input, o);
            o.vcolor = v.color;
        }

        void surf(Input IN, inout SurfaceOutputStandard o)
        {
            float2 uv = IN.worldPos.xz / _Tiling;
            fixed3 ground = tex2D(_MainTex, uv).rgb;
            ground *= lerp(0.8, 1.2, tex2D(_MainTex, uv * 0.21).a); // macro variation (alpha), breaks the tiling
            fixed3 rock = tex2D(_RockTex, IN.worldPos.xz / _RockTiling + IN.worldPos.y * 0.35).rgb;
            fixed3 c = lerp(ground, rock, saturate(IN.vcolor.a)) * IN.vcolor.rgb * 2.0;
            o.Albedo = c;
            o.Metallic = 0;
            o.Smoothness = _Glossiness;
            o.Alpha = 1;
        }
        ENDCG
    }
    FallBack "Diffuse"
}
