# Política de finales de línea: el repositorio guarda LF.
# Los atributos eol=lf prevalecen sobre core.autocrlf (que en esta
# máquina es true a nivel de sistema), de modo que el contenido que
# se confirma es siempre LF y no aparecen diffs por CRLF/LF.
* text=auto

# Documentación y configuración
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml  text eol=lf
*.ini  text eol=lf
*.cfg  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Código
*.py   text eol=lf
*.cs   text eol=lf
*.sh   text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.shader  text eol=lf
*.cginc   text eol=lf
*.hlsl    text eol=lf
*.compute text eol=lf
*.uss  text eol=lf
*.uxml text eol=lf

# Scripts de Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos YAML de Unity (Unity los escribe con LF)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat  text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.meta text eol=lf

# Binarios (sin conversión de finales de línea)
*.blend   binary
*.blend1  binary
*.fbx     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.psd     binary
*.tga     binary
*.tif     binary
*.tiff    binary
*.exr     binary
*.hdr     binary
*.wav     binary
*.mp3     binary
*.ogg     binary
*.mp4     binary
*.ttf     binary
*.otf     binary
*.dll     binary
*.unitypackage binary
*.zip     binary
*.7z      binary
